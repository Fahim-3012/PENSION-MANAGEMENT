{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: debug API",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "backend: build",
      "program": "${workspaceFolder}/backend/SmartPension.Api/bin/Debug/net8.0/SmartPension.Api.dll",
      "cwd": "${workspaceFolder}/backend/SmartPension.Api",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "http://localhost:5080"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Frontend: open in Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ]
}
